{
  "info": {
    "name": "Student Results API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "teacher"
    },
    {
      "key": "password",
      "value": "change-me-123"
    }
  ],
  "item": [
    {
      "name": "1. Add student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "students"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Amina Yusuf\",\n  \"student_code\": \"STU-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Add subject",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
